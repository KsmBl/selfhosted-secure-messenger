digraph G {
  graph [bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.6", fontname="Helvetica", fontsize=12 , rankdir=LR, nodesep="0.4"];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#5c6370", penwidth=1.2, fillcolor="#eef1f6", margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=11, color="#4c566a", penwidth=1.3, arrowsize=0.8];

  g [label="genesis\n00…00", fillcolor="#fff4cc", color="#b8860b"];
  e1 [label="#1 account.create\nhash₁ = SHA-256(00…00 ‖ entry₁)", fillcolor="#e3e9f8", color="#3b5ba5"];
  e2 [label="#2 device.approve\nhash₂ = SHA-256(hash₁ ‖ entry₂)", fillcolor="#e3e9f8", color="#3b5ba5"];
  e3 [label="#3 messages.delete\nhash₃ = SHA-256(hash₂ ‖ entry₃)", fillcolor="#e3e9f8", color="#3b5ba5"];
  more [label="…", shape=plaintext, style=""];
  { rank=same; g; e1; e2; e3; more; }
  g -> e1 -> e2 -> e3 -> more;
  x [label="changing entry #2 breaks\nhash₂ and every later hash\n→ verify-audit reports it", fillcolor="#fde2e1", color="#c0392b"];
  e2 -> x [style=dashed, color="#c0392b"];
  rules [label="Table owned by role ssm_audit;\nthe server may only SELECT / INSERT;\ntrigger blocks UPDATE / DELETE / TRUNCATE", shape=note, fillcolor="#fafafa", color="#9aa0a6", fontsize=10.5];
  e3 -> rules [style=dotted, arrowhead=none];
}
