digraph G {
  graph [bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.6", fontname="Helvetica", fontsize=12 , rankdir=LR];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#5c6370", penwidth=1.2, fillcolor="#eef1f6", margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=11, color="#4c566a", penwidth=1.3, arrowsize=0.8];

  req [label="Member or admin\ndeletes (for everyone)", fillcolor="#d7f0e3", color="#2e8b57"];
  prog [label="in_progress"];
  act [label="active_removed\nciphertext → tombstone,\nfiles marked, members notified", fillcolor="#e3e9f8", color="#3b5ba5"];
  pend [label="backup_purge_pending\ncopies may still be in backups"];
  done [label="backup_purge_done\nafter the backup retention (30 days)", fillcolor="#d7f0e3", color="#2e8b57"];
  failed [label="failed", fillcolor="#fde2e1", color="#c0392b"];
  journal [label="Deletion journal\n(IDs, kept 30 days)", shape=cylinder, fillcolor="#e3e9f8", color="#3b5ba5"];
  req -> prog -> act -> pend -> done;
  prog -> failed [style=dashed];
  act -> journal [label="record", style=dashed];
}
